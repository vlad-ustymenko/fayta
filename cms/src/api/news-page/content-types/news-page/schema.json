{
  "kind": "singleType",
  "collectionName": "news_pages",
  "info": {
    "singularName": "news-page",
    "pluralName": "news-pages",
    "displayName": "News Page"
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {
    "i18n": {
      "localized": true
    }
  },
  "attributes": {
    "news_cards": {
      "type": "relation",
      "relation": "oneToMany",
      "target": "api::news-card.news-card"
    },
    "newsCategories": {
      "type": "component",
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      },
      "component": "components.news-categorie",
      "repeatable": true
    },
    "moreButton": {
      "type": "component",
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      },
      "component": "components.button",
      "repeatable": false
    },
    "backText": {
      "type": "string",
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      }
    },
    "initialCount": {
      "type": "integer",
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      }
    }
  }
}
